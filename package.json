{
  "name": "book-management-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for managing books with a ranked recommendation feed",
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts | pino-pretty",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:build": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run test:build && mocha",
    "test:int": "npm run test:build && mocha --config .mocharc.integration.json",
    "test:all": "mocha && mocha --config .mocharc.integration.json",
    "coverage": "npm run test:build && c8 npm run test:all",
    "check": "npm run lint && npm run format:check && npm test",
    "seed:bulk": "node dist/scripts/bulk-books.js",
    "rank:recompute": "node dist/scripts/recompute-rank-scores.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "mocha": "^12.0.3",
    "mongodb-memory-server-core": "^11.3.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "sinon": "^22.1.0",
    "supertest": "^7.3.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
