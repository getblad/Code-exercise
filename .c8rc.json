{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/server.ts",
    "src/infrastructure/**",
    "src/seed/**",
    "src/scripts/**",
    "src/modules/**/*.model.ts",
    "src/**/*.types.ts",
    "src/**/*.d.ts"
  ],
  "exclude-after-remap": true,
  "reporter": ["text", "html"],
  "check-coverage": true,
  "lines": 85,
  "branches": 80,
  "functions": 85,
  "statements": 85
}
